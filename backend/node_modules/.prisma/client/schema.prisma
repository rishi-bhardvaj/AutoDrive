generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum FuelType {
  PETROL
  DIESEL
  CNG
  ELECTRIC
  HYBRID
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum VehicleStatus {
  AVAILABLE
  BOOKED
  RENTED
  UNDER_REPAIR
  INACTIVE
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum ServiceStatus {
  NEW
  CONTACTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RepairStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SaleVehicleStatus {
  AVAILABLE
  BOOKED
  SOLD
  INACTIVE
}

enum PurchaseEnquiryStatus {
  NEW
  CONTACTED
  TEST_DRIVE
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum SellEnquiryStatus {
  NEW
  CONTACTED
  INSPECTION
  NEGOTIATION
  CLOSED
  REJECTED
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Vehicle {
  id                 String          @id @default(cuid())
  brand              String
  model              String
  slug               String          @unique
  registrationNumber String          @unique
  year               Int
  fuelType           FuelType        @default(DIESEL)
  transmission       Transmission    @default(AUTOMATIC)
  seats              Int             @default(5)
  dailyRentalPrice   Float
  securityDeposit    Float           @default(5000)
  description        String?
  features           String[]        @default([])
  images             String[]        @default([])
  status             VehicleStatus   @default(AVAILABLE)
  isFeatured         Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  bookings           RentalBooking[]
  repairs            RepairRecord[]
}

model RentalBooking {
  id               String        @id @default(cuid())
  bookingReference String        @unique
  vehicleId        String
  vehicle          Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  customerName     String
  customerPhone    String
  customerEmail    String?
  pickupDate       DateTime
  returnDate       DateTime
  pickupLocation   String
  totalDays        Int
  estimatedAmount  Float
  securityDeposit  Float
  notes            String?
  status           BookingStatus @default(PENDING)
  adminNotes       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model ServiceRequest {
  id                 String        @id @default(cuid())
  requestReference   String        @unique
  customerName       String
  customerPhone      String
  customerEmail      String?
  vehicleDetails     String
  serviceType        String
  preferredDate      DateTime?
  pickupDropRequired Boolean       @default(false)
  pickupAddress      String?
  description        String?
  status             ServiceStatus @default(NEW)
  estimatedCost      Float?
  adminNotes         String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model RepairRecord {
  id               String       @id @default(cuid())
  repairReference  String       @unique
  vehicleId        String
  vehicle          Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  issueDescription String
  estimatedCost    Float?
  actualCost       Float?
  startDate        DateTime     @default(now())
  endDate          DateTime?
  status           RepairStatus @default(IN_PROGRESS)
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model SaleVehicle {
  id                String            @id @default(cuid())
  brand             String
  model             String
  slug              String            @unique
  year              Int
  registrationYear  Int
  kilometres        Int
  fuelType          FuelType          @default(PETROL)
  transmission      Transmission      @default(MANUAL)
  ownership         Int               @default(1)
  price             Float
  location          String            @default("Delhi NCR")
  insuranceValidity String?
  description       String
  features          String[]          @default([])
  images            String[]          @default([])
  status            SaleVehicleStatus @default(AVAILABLE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  enquiries         PurchaseEnquiry[]
}

model PurchaseEnquiry {
  id            String                @id @default(cuid())
  saleVehicleId String
  saleVehicle   SaleVehicle           @relation(fields: [saleVehicleId], references: [id], onDelete: Cascade)
  customerName  String
  customerPhone String
  customerEmail String?
  message       String?
  offeredPrice  Float?
  status        PurchaseEnquiryStatus @default(NEW)
  adminNotes    String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model SellEnquiry {
  id                String            @id @default(cuid())
  enquiryReference  String            @unique
  customerName      String
  customerPhone     String
  customerEmail     String?
  carMakeModel      String
  registrationYear  Int
  registrationState String?
  kilometres        Int
  fuelType          FuelType          @default(PETROL)
  expectedPrice     Float
  description       String?
  photos            String[]          @default([])
  status            SellEnquiryStatus @default(NEW)
  adminNotes        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model NotificationSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userRole  String   @default("admin")
  createdAt DateTime @default(now())
}
